# nginx in front of SearXNG. Get a certificate with certbot (certbot --nginx -d search.example.com).
# Replace PUT-YOUR-SEARCH-KEY-HERE with the same value as SEARXNG_KEY in Vercel.
server {
    listen 80;
    server_name search.example.com;

    location / {
        # Only DocBatch, which sends this header, may search.
        if ($http_x_search_key != "PUT-YOUR-SEARCH-KEY-HERE") {
            return 403;
        }
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
