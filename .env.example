# Copy to .env.local for local testing with `npx vercel dev`.
# On Vercel, add these in Project Settings > Environment Variables instead.

# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Recommended. Without it, anyone who finds your site can spend your OpenAI credit.
APP_PASSWORD=

# Optional. Comma-separated list of allowed models. gpt-6-luna is the default when allowed.
# OPENAI_MODELS=gpt-6-luna,gpt-5.6-luna

# Web search: only your own SearXNG server (free, see searxng/README.md). Without it, web search is off.
# The chat's web search never uses a paid service (no OpenAI search, no Tavily).
SEARXNG_URL=api.timilehin-olowu.xyz
SEARXNG_KEY=

# Optional, paid: Google results from serper.dev (2,500 free searches, then about $1 per 1,000), used ONLY by
# the lead engine, ONLY for companies the website and free searches could not solve. Leave empty to never use it.
# SERPER_PER_COMPANY: Google searches per unsolved company (default 2, 0 turns it off, at most 4).
# SERPER_MIN_BALANCE: stop when the Serper account is down to this many credits (default 0).
SERPER_KEY=
# SERPER_PER_COMPANY=2
# SERPER_MIN_BALANCE=0

# Optional: show the OpenAI credit left in the sidebar. OpenAI has no balance API, so the app shows
# OPENAI_CREDIT minus the cost OpenAI reports since OPENAI_CREDIT_SINCE. Needs an admin key (account owner:
# platform.openai.com > Settings > Organization > Admin keys). Server-side only; never put it in the page.
# Easiest: set OPENAI_CREDIT to the balance shown on your OpenAI billing page today, and OPENAI_CREDIT_SINCE to
# today's date. When you top up, update both.
OPENAI_ADMIN_KEY=
OPENAI_CREDIT=
OPENAI_CREDIT_SINCE=
