# Copy to .env.local for local testing with `npx vercel dev`.
# On Vercel, add these in Project Settings > Environment Variables instead.

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Recommended. Without it, anyone who finds your site can spend your Gemini quota.
APP_PASSWORD=

# Optional. Comma-separated list shown in the model dropdown (first one is the default).
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
