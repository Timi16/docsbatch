# Copy to .env.local for local testing with `npx vercel dev`.
# On Vercel, add these in Project Settings > Environment Variables instead.

# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Recommended. Without it, anyone who finds your site can spend your OpenAI credit.
APP_PASSWORD=

# Optional. Comma-separated list of allowed models. gpt-6-luna is the default when allowed.
# OPENAI_MODELS=gpt-6-luna,gpt-5.6-luna

# Web search: only your own SearXNG server (free, see searxng/README.md). Without it, web search is off.
# No paid search service (OpenAI search, Tavily) is ever used.
SEARXNG_URL=api.timilehin-olowu.xyz
SEARXNG_KEY=
